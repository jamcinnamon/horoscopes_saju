# Application Settings
APP_NAME="Horoscope & Saju Fortune Service"
APP_VERSION="0.1.0"
DEBUG=True
ENVIRONMENT=development

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Database Settings - MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=fortune_db
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=500

# Model Settings
HOROSCOPE_MODEL_PATH=./models/horoscope
SAJU_MODEL_PATH=./models/saju
MODEL_CACHE_ENABLED=True

# Fusion Engine Weights
HOROSCOPE_WEIGHT=0.5
SAJU_WEIGHT=0.5

# Caching (Optional)
REDIS_URL=redis://localhost:6379
CACHE_TTL=86400

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
API_RATE_LIMIT=10

# Retraining Settings
MIN_FEEDBACK_COUNT=1000
MIN_AVERAGE_RATING=3.0
AUTO_RETRAIN_ENABLED=False
